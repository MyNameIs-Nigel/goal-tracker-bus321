# Copy to .env.local for local development. Real values live in Vercel;
# .env* is git-ignored. Never put Neon credentials here (ADR-0003) — local
# development and local E2E use the Postgres container in docker-compose.yml.
#
#   cp .env.example .env.local && docker compose up -d

# Postgres. This value matches docker-compose.yml as-is.
DATABASE_URL=postgresql://bus321:bus321@localhost:5432/bus321

# Better Auth. Generate the secret with: openssl rand -base64 32
# Any non-empty string works locally; production's lives in Vercel only.
BETTER_AUTH_SECRET=local-dev-not-a-secret
BETTER_AUTH_URL=http://localhost:3000

# Test sign-in. 1 enables the Owner / Partner / Viewer buttons and the
# /api/e2e/* endpoints. Never set in production — VERCEL_ENV is the second
# lock (docs/ARCHITECTURE.md § Environments).
E2E_AUTH=1

# Pins "today" for tests that reason about yesterday or a week boundary.
# Leave unset for real time.
# E2E_FIXED_NOW=2026-09-19T12:00:00-06:00

# Google sign-in (Phase 1, H4/H5). Optional locally: without them the Google
# provider is simply not registered and the test sign-in is used instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The single account that becomes `owner` on first sign-in.
# OWNER_EMAIL=
